# Unity generates these and they are enormous — Library alone runs to gigabytes,
# and all of it is rebuilt from the files that ARE tracked. Committing any of it
# would make every pull a download of things your own machine can regenerate.
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# the local caches Unity keeps beside the project
/.vs/
/.gradle/
/[Ee]xport[Cc]andidates/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# crash dumps and OS litter
sysinfo.txt
crashlytics-build.properties
.DS_Store
Thumbs.db
